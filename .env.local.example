# =============================================================================
# PlantPal Marketing OS — Environment Variables
# Copy to .env.local (never commit .env.local)
# Set the same values in Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (required) — Project Settings → API ---
# Only URL + anon key are public-safe (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --- Private app access (required for production) ---
# Server-only — never use NEXT_PUBLIC_ prefix
APP_PASSWORD=choose-a-strong-founder-password
# Optional extra signing secret (defaults to APP_PASSWORD)
# AUTH_SECRET=random-32-char-string

# --- Vercel Cron (required for background agents) ---
# Server-only — used to authenticate /api/cron/agents
CRON_SECRET=generate-a-long-random-secret

# --- OpenAI — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- OpenWeather — https://openweathermap.org/api ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_PROVIDER=openweather

# --- PlantNet — https://my.plantnet.org/ ---
PLANTNET_API_KEY=your_plantnet_api_key_here

# --- Perenual — https://perenual.com/docs/api ---
PERENUAL_API_KEY=your_perenual_api_key_here

# --- SerpAPI — https://serpapi.com/ ---
SERPAPI_KEY=your_serpapi_key_here

# --- X (Twitter) API — https://developer.x.com/ ---
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
# OAuth 1.0a — required only for publishing (human-approved posts)
# X_ACCESS_TOKEN=your_x_access_token_here
# X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# --- Optional production hardening ---
# Set to true to block all traffic if APP_PASSWORD is missing in production
# REQUIRE_APP_PASSWORD=true
