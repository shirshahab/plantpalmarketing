# =============================================================================
# PlantPal Marketing OS — Environment Variables
# Copy to .env.local (never commit .env.local)
# Set the same values in Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- Supabase (required) — Project Settings → API ---
# Only URL + anon key are public-safe (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --- Auth (Supabase) ---
# Enable Email provider in Supabase Dashboard → Authentication
# Disable public sign-ups; create users manually (see AUTH.md)
# Only URL + anon key needed — no APP_PASSWORD

# --- Vercel Cron (required for background agents) ---
# Server-only — used to authenticate /api/cron/agents
CRON_SECRET=generate-a-long-random-secret

# --- OpenAI — https://platform.openai.com/api-keys ---
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- OpenWeather — https://openweathermap.org/api ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_PROVIDER=openweather
# HQ garden weather location (server-only, never NEXT_PUBLIC_)
HQ_WEATHER_LOCATION=Pasadena,CA,US

# --- PlantNet — https://my.plantnet.org/ ---
PLANTNET_API_KEY=your_plantnet_api_key_here

# --- Perenual — https://perenual.com/docs/api ---
PERENUAL_API_KEY=your_perenual_api_key_here

# --- SerpAPI — https://serpapi.com/ ---
SERPAPI_KEY=your_serpapi_key_here

# --- Reddit (script app) — https://old.reddit.com/prefs/apps ---
# Server-only. Used for help-first replies with founder approval.
# Create app type "script", redirect uri http://localhost:3000/reddit/callback
# Warm the account up manually before automating. Follow Reddit Developer Terms.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=plantpal-marketing-os/0.1 by u/YOUR_USERNAME

# --- Optional image generation (uses OpenAI when OPENAI_API_KEY is set) ---
# OPENAI_IMAGE_MODEL=dall-e-3

# --- X (Twitter) API — https://developer.x.com/ ---
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
# OAuth 1.0a — required only for publishing (human-approved posts)
# Without these, the Content Calendar hides "Publish to X" and falls back to
# the manual copy/post workflow. All other platforms are always manual.
# X_ACCESS_TOKEN=your_x_access_token_here
# X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# See AUTH.md for hq.getplantpal.com login setup and first admin user
