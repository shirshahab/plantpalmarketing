{
  "crons": [
    {
      "path": "/api/cron/run-agents",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/intelligence/f5bot/cron",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/hq/daily-engine/cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/ivy/daily-brief/cron",
      "schedule": "30 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
